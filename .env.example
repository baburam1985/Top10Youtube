# Top 10 YouTube Video Generator — API Keys
# Copy this file to .env and fill in your keys.

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Tavily Search — https://app.tavily.com
TAVILY_API_KEY=tvly-...

# ElevenLabs — https://elevenlabs.io
ELEVENLABS_API_KEY=...

# Replicate (Flux image generation) — https://replicate.com
REPLICATE_API_TOKEN=r8_...

# Freesound (background music) — https://freesound.org/apiv2/apply/
FREESOUND_CLIENT_ID=...
FREESOUND_API_KEY=...
